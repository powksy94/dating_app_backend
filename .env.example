# Copy this file to .env and fill in your own values. Never commit the real .env.

# Server port
PORT=3000

# MongoDB connection string. Use a dedicated database name per environment
# (e.g. a "_dev" suffix locally) so local testing never touches production
# data — see README.md, "Dev vs production database".
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?appName=YourApp

# Secret used to sign JWT access/refresh tokens. Use a long random string.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Origin allowed to call the API via CORS. Only the web admin panel needs
# this: the mobile app calls the API over native HTTP, which isn't subject
# to CORS at all.
CORS_ORIGIN=https://your-admin-panel.example.com

# Cloudinary (profile photos, event covers, chat media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (paid event tickets)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# RevenueCat webhook signature (subscription status sync)
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# RevenueCat secret API key (Project Settings > API Keys > Secret API keys,
# not the public SDK key already embedded in the app). Used to grant the
# founding-member promotional entitlement at claim time. Leave unset to
# disable claiming (the request responds 503 instead of crashing).
# REVENUECAT_SECRET_API_KEY=sk_xxx

# Optional: Spotify Web API (band search with cover images for favoriteBands).
# Create an app at https://developer.spotify.com/dashboard to get these; no
# Spotify user login is involved, this only reads public catalog data. Leave
# unset to disable band search (existing free-text band pills keep working).
# SPOTIFY_CLIENT_ID=your_client_id
# SPOTIFY_CLIENT_SECRET=your_client_secret

# Optional: Discord account connection (dev_features/oauth-social-connections.md).
# Create an app at https://discord.com/developers/applications, set its OAuth2
# redirect to nocturne://oauth-callback, scope "identify". Both this and
# TOKEN_ENCRYPTION_KEY below must be set for the feature to turn on; the app
# shows "coming soon" instead when either is missing.
# DISCORD_CLIENT_ID=your_discord_client_id
# DISCORD_CLIENT_SECRET=your_discord_client_secret

# Optional: encrypts stored OAuth tokens (Discord...) at rest. 32 bytes,
# base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this key makes every already-stored connection unreadable (it will
# simply look disconnected, not crash) — rotate with care.
# TOKEN_ENCRYPTION_KEY=

# Optional: Firebase service account credentials as a raw JSON string, used
# for push notifications. If unset, falls back to a local service account
# key file at the repo root (dev only, see
# src/infrastructure/config/firebase-admin.ts) — never commit that file either.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# Minimum mobile app build number (the number after "+" in pubspec.yaml)
# allowed to use the API. Older builds get an "update required" response.
# Leave unset to disable the check (recommended in local development).
# MIN_APP_BUILD=8

# Set to "production" by your hosting platform; disables the /api/dev
# routes (mock/seed/reset endpoints) when set.
NODE_ENV=development
